# Coffer configuration. Copy to .env with ./scripts/init-env.sh, which fills in every
# REPLACE_ME_* value with a freshly generated secret and sets the file mode to 0600.
# Never commit a .env that holds a real secret: .env is gitignored.
#
# Every variable the server reads is listed here, including the optional ones.

# Master key: base64 of exactly 32 bytes (44 characters). Wraps each project's data key.
# The server refuses to start while this still holds the placeholder below.
# Generate one with: openssl rand -base64 32
COFFER_MASTER_KEY=REPLACE_ME_WITH_BASE64_32_BYTES

# Old master key, set only while rotating keys. Re-wraps every data key at boot.
COFFER_MASTER_KEY_PREVIOUS=

# Platform admin, created on first boot only when no users exist yet.
COFFER_BOOTSTRAP_ADMIN_EMAIL=admin@coffer.local

# Platform admin password: at least 12 characters. Printed once by init-env.sh.
COFFER_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_WITH_A_12_CHAR_PASSWORD

# Host port the API is published on (compose maps 127.0.0.1:$COFFER_PORT to 8420).
COFFER_PORT=8420

# Listen address. The container sets 0.0.0.0; a process on the host should keep loopback.
COFFER_BIND_ADDR=127.0.0.1

# Set to 1 only behind a reverse proxy you control: enables rightmost-untrusted X-Forwarded-For.
COFFER_TRUST_PROXY=

# production (default) refuses the degraded single-role database mode; development allows it.
COFFER_ENV=production

# Database owner role. In compose this is the PostgreSQL superuser that runs migrations.
POSTGRES_USER=coffer

# Owner role password. Generated by init-env.sh (hex, so it is safe inside a URL).
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_DB_PASSWORD

# Database name.
POSTGRES_DB=coffer

# Runtime role password. The server connects as coffer_app, which cannot UPDATE or DELETE audit rows.
COFFER_APP_DB_PASSWORD=REPLACE_ME_WITH_A_DB_PASSWORD

# Owner connection URL for migrations. Leave empty to derive it from the values above.
COFFER_MIGRATION_DATABASE_URL=

# Runtime connection URL. Leave empty to derive it from the values above.
DATABASE_URL=

# Database host. 127.0.0.1 for a process on the host; compose overrides it to the db service.
COFFER_DB_HOST=127.0.0.1

# Database port.
COFFER_DB_PORT=5432

# PostgreSQL SSL mode: disable inside the compose network, require behind a TLS proxy.
COFFER_DB_SSLMODE=disable

# Set to 1 to boot as the owner role without COFFER_APP_DB_PASSWORD (development only).
COFFER_ALLOW_DEGRADED_DB_ROLE=

# Runtime connection pool ceiling. Sized for the documented 50-concurrent-read target
# with headroom; bounded so a load spike cannot exhaust a shared database's
# max_connections (PostgreSQL defaults to 100). Two Coffer processes open at most
# 2x this value. Default 32.
COFFER_DB_MAX_CONNS=

# Runtime pool warm floor, so the first burst after a quiet period does not pay
# connection-establishment cost. Default 4.
COFFER_DB_MIN_CONNS=
