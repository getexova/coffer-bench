# Coffer configuration -- example file.
#
# Create your real configuration with:   ./scripts/init-env.sh
# That copies this file to .env (mode 0600) and replaces the three secrets below
# (master key, bootstrap admin password, Postgres password) with fresh random values.
#
# Rules for this file (it is read by compose `env_file` and by the scripts):
#   * one KEY=value per line, no quotes, no spaces around '=', no inline comments
#   * never commit .env (it is in .gitignore)
#   * all configuration comes from environment variables; nothing else is read

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------

# REQUIRED. Base64 of exactly 32 random bytes. Wraps every project's data key.
# The server refuses to start if this is missing, is not 32 bytes, or is still
# this placeholder. Generate one with:  openssl rand -base64 32
# Back it up separately from database backups: a backup is useless without it.
COFFER_MASTER_KEY=REPLACE_ME_with_output_of_init_env_sh_0000000000=

# OPTIONAL. Only during master-key rotation: the old key. Set it together with a
# new COFFER_MASTER_KEY, run ./scripts/up.sh (all data keys are re-wrapped before
# /readyz turns 200), then remove this line again. See README "Master key rotation".
#COFFER_MASTER_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Bootstrap platform admin (used only on first boot, when no users exist yet)
# ---------------------------------------------------------------------------

# REQUIRED. Email of the platform admin created on first boot.
COFFER_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# REQUIRED. Password for that admin (at least 12 characters).
# init-env.sh replaces this with a random 32-character URL-safe value.
COFFER_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_bootstrap_admin_password

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# REQUIRED (in .env). Host port. compose publishes 127.0.0.1:${COFFER_PORT} -> container 8420.
# Only loopback is published: put a TLS-terminating reverse proxy in front for remote use.
COFFER_PORT=8420

# OPTIONAL. Bind address inside the container. Default :8420. Leave unset with compose.
#COFFER_LISTEN_ADDR=:8420

# OPTIONAL. Set to true ONLY when Coffer sits behind a reverse proxy that overwrites
# X-Forwarded-For; the first X-Forwarded-For entry is then recorded as source IP in
# the audit log. Default false (the TCP peer address is used).
#COFFER_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Database (also consumed by the `db` service: postgres:16)
# ---------------------------------------------------------------------------

# REQUIRED. Database owner role, password and database name.
POSTGRES_USER=coffer
POSTGRES_PASSWORD=REPLACE_ME_postgres_password
POSTGRES_DB=coffer

# OPTIONAL. Database host and port. Default db / 5432. compose.yaml already sets
# POSTGRES_HOST=db for the server; only change these when running the server outside compose.
#POSTGRES_HOST=db
#POSTGRES_PORT=5432

# OPTIONAL. libpq sslmode for the server's database connection (disable, require,
# verify-ca, verify-full, ...). Default disable: with compose the database is only
# reachable on the private compose network. Ignored when COFFER_DATABASE_URL is set.
#POSTGRES_SSLMODE=disable

# OPTIONAL. Full libpq URL; if set it overrides all POSTGRES_* variables above for the
# server's connection (used by tests), e.g. postgres://user:pass@host:5432/db?sslmode=disable
#COFFER_DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication tuning
# ---------------------------------------------------------------------------

# OPTIONAL. Lifetime of personal access tokens issued by `coffer login`. Go duration. Default 720h (30 days).
#COFFER_PAT_TTL=720h

# OPTIONAL. argon2id memory cost in KiB. Default 65536 (64 MiB); minimum 19456.
#COFFER_ARGON2_MEMORY_KIB=65536

# OPTIONAL. If true, users created with an initial password (org owners created by the
# platform admin, members added with `coffer member add`) must run `coffer passwd`
# before doing anything else. Default false.
#COFFER_REQUIRE_PASSWORD_CHANGE=false

# ---------------------------------------------------------------------------
# Script-only variables (NOT read by the server; set them in your shell when
# running ./scripts/*.sh, not in .env)
# ---------------------------------------------------------------------------
#
# COFFER_COMPOSE              compose command to use, e.g. "podman-compose" or "docker compose".
#                             Default: auto-detect docker compose -> podman compose ->
#                             docker-compose -> podman-compose.
# COFFER_CONTAINER_RUNTIME    podman or docker, for one-off containers in build.sh/test.sh.
#                             Default: podman if installed, else docker.
# COFFER_READY_TIMEOUT        seconds up.sh/restore.sh wait for /readyz. Default 180.
# COFFER_SKIP_CLI_BUILD       1 = up.sh does not run ./scripts/build.sh after the stack is
#                             ready. Default 0 (up.sh also builds ./bin/coffer).
# COFFER_FROM_UP              internal: set by up.sh when it calls init-env.sh, which then
#                             omits its "Next: ./scripts/up.sh" hint. Do not set it yourself.
# COFFER_BUILD_IN_CONTAINER   1 = build.sh always builds inside the pinned golang image.
#                             Default 0 (use a local Go >= 1.26 when present).
# COFFER_TEST_IN_CONTAINER    1 = test.sh always runs inside the pinned golang image. Default 0.
# COFFER_TEST_DATABASE_URL    database URL for test.sh. Default: unset (a throwaway
#                             postgres:16 container is started and removed).
# COFFER_E2E                  1 = test.sh also runs the e2e suite against ./scripts/up.sh's
#                             stack. Default 0.
# COFFER_SMOKE_PORT           host port for ./scripts/ops-smoke.sh's private stack.
#                             Default: a free loopback port.
# COFFER_E2E_URL              server the e2e suite (test/e2e) talks to.
#                             Default http://127.0.0.1:8420.
# COFFER_E2E_CLI              CLI binary the e2e suite drives. Default ./bin/coffer.
# COFFER_E2E_ADMIN_EMAIL      platform admin the e2e suite logs in as. Default admin@example.com.
# COFFER_E2E_ADMIN_PASSWORD   that admin's password. Default: COFFER_BOOTSTRAP_ADMIN_PASSWORD
#                             from .env.

# ---------------------------------------------------------------------------
# CLI variables (NOT read by the server; set them in the shell that runs ./bin/coffer)
# ---------------------------------------------------------------------------
#
# COFFER_URL                  server URL, e.g. http://127.0.0.1:8420 (same as --url).
# COFFER_TOKEN                a PAT or service token. While it is set, the CLI reads and
#                             writes no config file.
